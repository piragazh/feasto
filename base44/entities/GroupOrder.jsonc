{
  "name": "GroupOrder",
  "type": "object",
  "properties": {
    "restaurant_id": {
      "type": "string"
    },
    "restaurant_name": {
      "type": "string"
    },
    "host_email": {
      "type": "string",
      "description": "Person who created the group order"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "locked",
        "placed"
      ],
      "default": "open",
      "description": "open = accepting items, locked = ready for checkout, placed = order submitted"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "delivery_address": {
      "type": "string"
    },
    "share_code": {
      "type": "string",
      "description": "Unique code to share with friends"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "restaurant_id",
    "host_email"
  ]
}