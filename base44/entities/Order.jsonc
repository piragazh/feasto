{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "Unique order number for collection orders (e.g., C-1234)"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Client-supplied key to prevent duplicate order creation on double-submit"
    },
    "payment_intent_id": {
      "type": "string",
      "description": "Stripe PaymentIntent ID or kiosk terminal transaction ref \u2014 used as dedup key to prevent double-payment creating two orders"
    },
    "restaurant_id": {
      "type": "string"
    },
    "restaurant_name": {
      "type": "string"
    },
    "driver_id": {
      "type": "string",
      "description": "Assigned driver ID"
    },
    "driver_location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      },
      "description": "Real-time driver location"
    },
    "delivery_coordinates": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      },
      "description": "Delivery destination coordinates"
    },
    "optimized_route": {
      "type": "object",
      "description": "AI-optimized delivery route"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "menu_item_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "customizations": {
            "type": "object",
            "description": "Customer's customization choices (e.g., size, toppings, extras)"
          },
          "itemQuantities": {
            "type": "object",
            "description": "Quantities for multiple-choice customizations"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "delivery_fee": {
      "type": "number"
    },
    "small_order_surcharge": {
      "type": "number",
      "default": 0,
      "description": "Surcharge added when order is below minimum (delivery only)"
    },
    "discount": {
      "type": "number"
    },
    "discount_reason_code": {
      "type": "string",
      "description": "Reason code for manual discount (e.g., loyalty_gesture, damage_compensation)"
    },
    "coupon_code": {
      "type": "string",
      "description": "LEGACY: Single coupon code for backward compatibility. New orders use coupon_codes array. Kept for historic order queries (per-customer limit checks filter on this field)."
    },
    "coupon_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "CURRENT: Array of up to 3 validated coupon codes applied to this order. Populated server-side only. Never trust client-supplied values."
    },
    "total": {
      "type": "number"
    },
    "platform_commission_amount": {
      "type": "number",
      "description": "Commission taken by platform"
    },
    "restaurant_earnings": {
      "type": "number",
      "description": "Amount restaurant receives (total - commission)"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "card",
        "apple_pay",
        "google_pay",
        "pay_at_counter"
      ],
      "default": "cash",
      "description": "How the order was or will be paid. 'pay_at_counter' = kiosk order placed, payment NOT yet collected \u2014 staff must take payment before kitchen prepares. 'card' = paid via card (online Stripe or kiosk terminal \u2014 see payment_intent_id). 'cash' = cash on delivery (online orders only)."
    },
    "order_type": {
      "type": "string",
      "enum": [
        "delivery",
        "collection",
        "takeaway",
        "dine_in"
      ],
      "default": "delivery",
      "description": "Whether order is for delivery, collection, takeaway, or dine-in"
    },
    "table_id": {
      "type": "string",
      "description": "Table ID for dine-in orders"
    },
    "table_number": {
      "type": "string",
      "description": "Human-readable table number for dine-in orders (e.g., Table 5)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "preparing",
        "out_for_delivery",
        "ready_for_collection",
        "delivered",
        "collected",
        "cancelled",
        "refund_requested",
        "refund_rejected_by_restaurant",
        "refund_under_platform_review",
        "refunded"
      ],
      "default": "pending",
      "description": "Order workflow status. For kiosk pay_at_counter orders: 'pending' means awaiting payment collection at counter \u2014 kitchen should NOT start until staff confirms payment and moves to 'confirmed'."
    },
    "rejection_reason": {
      "type": "string"
    },
    "refund_request_date": {
      "type": "string",
      "format": "date-time"
    },
    "refund_request_reason": {
      "type": "string"
    },
    "refund_request_description": {
      "type": "string"
    },
    "refund_request_type": {
      "type": "string",
      "enum": [
        "full",
        "partial"
      ]
    },
    "refund_requested_amount": {
      "type": "number"
    },
    "refund_requested_items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "refund_rejection_reason": {
      "type": "string"
    },
    "refund_rejected_date": {
      "type": "string",
      "format": "date-time"
    },
    "refund_approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "refund_amount": {
      "type": "number"
    },
    "refund_paid_by": {
      "type": "string",
      "enum": [
        "restaurant",
        "platform"
      ],
      "description": "Who covers the refund cost"
    },
    "platform_override_reason": {
      "type": "string"
    },
    "platform_override_date": {
      "type": "string",
      "format": "date-time"
    },
    "platform_override_by": {
      "type": "string"
    },
    "status_history": {
      "type": "array",
      "description": "Track all status changes",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "delivery_address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "estimated_delivery": {
      "type": "string"
    },
    "actual_delivery_time": {
      "type": "string"
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time"
    },
    "is_scheduled": {
      "type": "boolean",
      "default": false
    },
    "group_order_id": {
      "type": "string"
    },
    "is_group_order": {
      "type": "boolean",
      "default": false
    },
    "group_order_host": {
      "type": "string"
    },
    "guest_name": {
      "type": "string"
    },
    "guest_email": {
      "type": "string"
    },
    "loyalty_points_earned": {
      "type": "number",
      "default": 0
    },
    "loyalty_points_awarded": {
      "type": "boolean",
      "default": false,
      "description": "Whether loyalty points have been credited \u2014 also acts as optimistic-lock flag for concurrent award calls"
    },
    "third_party_platform": {
      "type": "string"
    },
    "third_party_order_id": {
      "type": "string",
      "description": "External platform order ID (e.g. Uber Eats) \u2014 dedup key for webhook retries"
    },
    "offline_created": {
      "type": "boolean",
      "default": false,
      "description": "True if order originated from offline POS mode and synced later"
    },
    "offline_created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the order was created in offline mode (local timestamp)"
    },
    "offline_created_by": {
      "type": "string",
      "description": "POS operator email/staff_id who created this offline order"
    },
    "offline_created_by_name": {
      "type": "string",
      "description": "POS operator full name (snapshot at creation time for audit readability)"
    },
    "offline_created_by_role": {
      "type": "string",
      "description": "POS operator role (cashier/waiter/manager/kitchen_staff) at time of order creation"
    },
    "offline_synced_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the offline order was synced to server"
    },
    "needs_review": {
      "type": "boolean",
      "default": false,
      "description": "True if offline sync validation flagged issues (discount capped, coupon rejected, etc.)"
    },
    "sync_validation_notes": {
      "type": "string",
      "description": "Details of any validation issues found during offline sync (for audit trail)"
    },
    "offline_review_status": {
      "type": "string",
      "enum": [
        "new",
        "acknowledged",
        "resolved",
        "escalated"
      ],
      "description": "Manager review state for flagged offline orders (new=just flagged, acknowledged=manager confirmed, resolved=acceptable as-is, escalated=needs investigation)"
    },
    "offline_review_by": {
      "type": "string",
      "description": "Email of manager who reviewed/acknowledged the flagged order"
    },
    "offline_review_at": {
      "type": "string",
      "format": "date-time",
      "description": "When manager last reviewed/acknowledged this flagged order"
    },
    "offline_review_reason_code": {
      "type": "string",
      "enum": [
        "price_adjusted_on_sync",
        "acceptable_policy_override",
        "customer_already_served",
        "minor_discrepancy",
        "potential_abuse",
        "large_price_mismatch",
        "repeated_offline_issues",
        "needs_refund_followup",
        "other"
      ],
      "description": "Structured reason code for resolved/escalated decision (required for terminal actions)"
    },
    "offline_review_notes": {
      "type": "string",
      "description": "Manager notes: required if reason_code='other', optional otherwise"
    }
  },
  "required": [
    "restaurant_id",
    "items",
    "total"
  ]
}