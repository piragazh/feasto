{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "Unique order number for collection orders (e.g., C-1234)"
    },
    "order_source": {
      "type": "string",
      "enum": [
        "online",
        "pos",
        "kiosk",
        "third_party"
      ],
      "default": "online",
      "description": "Channel through which the order was placed."
    },
    "covers": {
      "type": "number",
      "description": "How many people are on the table. Used for seat numbering and for sales-per-cover."
    },
    "loyalty_backfilled": {
      "type": "boolean",
      "description": "This order's points have been redistributed from the pooled service-account balance to the customer's phone. Stops a second backfill run crediting the same order twice."
    },
    "stock_applied": {
      "type": "boolean",
      "default": false,
      "description": "Set once this order's stock has been deducted. Makes applyOrderStock exactly-once, so the workflow firing twice - or anyone calling the function directly - can never deduct the same order twice."
    },
    "stock_restored": {
      "type": "boolean",
      "default": false,
      "description": "Set once a cancelled or refunded order's stock has been put back. Exactly-once, for the same reason."
    },
    "cash_amount": {
      "type": "number",
      "description": "Cash that went INTO the drawer for this order, net of change and including any cash tip. Structured on purpose: split payments used to be recorded as payment_method 'cash' for the WHOLE total with the real breakdown only in free-text notes, so a £10 cash + £20 card bill counted as £30 of cash - making the drawer look £20 short and the Reports cash/card split wrong. Derived server-side as (total + tip) - card_amount so the two always reconcile."
    },
    "card_amount": {
      "type": "number",
      "description": "Amount taken by card for this order, including any card tip. The exact figure - card terminals don't give change - so cash is derived from it rather than the other way round."
    },
    "terminal": {
      "type": "number",
      "description": "Which till took this order (POS terminal number). A multi-till shop has one cash drawer per till, so a drawer's expected cash must only count its own sales."
    },
    "tip_amount": {
      "type": "number",
      "default": 0,
      "description": "Tip paid by the customer. Stored SEPARATELY from total and deliberately excluded from revenue: under the Employment (Allocation of Tips) Act 2023 tips belong to staff and must be passed on in full. Folding this into total would make every revenue report overstate the restaurant's takings by money it is obliged to pay out."
    },
    "tip_method": {
      "type": "string",
      "enum": ["cash", "card"],
      "description": "How the tip was paid. Recorded because cash and card tips are handled differently for distribution and payroll."
    },
    "staff_id": {
      "type": "string",
      "description": "Staff member who rang in this order. Set SERVER-SIDE from the verified staff session token, never from the client - a client-supplied value could be forged, which would make performance figures and audit trails meaningless. POSStaffManager already reports against this field."
    },
    "staff_name": {
      "type": "string",
      "description": "Staff name captured at the time of sale, so reports stay readable if the staff record is later edited or deleted."
    },
    "staff_role": {
      "type": "string",
      "description": "Role held by the staff member when the order was placed."
    },
    "idempotency_key": {
      "type": "string",
      "description": "Client-supplied key to prevent duplicate order creation on double-submit"
    },
    "payment_intent_id": {
      "type": "string",
      "description": "Stripe PaymentIntent ID or kiosk terminal transaction ref"
    },
    "restaurant_id": {
      "type": "string"
    },
    "restaurant_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string",
      "description": "Email of the customer who placed the order \u2014 authenticated user email or guest email. Used for order lookup on Orders page."
    },
    "customer_phone": {
      "type": "string",
      "description": "Phone number of the customer who placed the order. Used for order lookup on Orders page (covers guest checkout)."
    },
    "driver_id": {
      "type": "string",
      "description": "Assigned driver ID"
    },
    "driver_location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      },
      "description": "Real-time driver location"
    },
    "delivery_coordinates": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      },
      "description": "Delivery destination coordinates"
    },
    "optimized_route": {
      "type": "object",
      "description": "AI-optimized delivery route"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "menu_item_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "customizations": {
            "type": "object"
          },
          "itemQuantities": {
            "type": "object"
          },
          "course": {
            "type": "string",
            "enum": ["drinks", "starters", "mains", "desserts"],
            "description": "Which course this line belongs to. Absent means mains, the commonest case, so existing orders are unaffected."
          },
          "seat": {
            "type": "number",
            "description": "Which cover ordered it, so food reaches the right person and a bill can be split by seat. 0 or absent means it is for the table (sides, sharing platters)."
          },
          "fired": {
            "type": "boolean",
            "description": "This line has been sent to the kitchen. HELD and FIRED are explicit states, never inferred: if a waiter believes mains were sent and they are sitting unfired, the table waits until they complain."
          },
          "fired_at": {
            "type": "string",
            "format": "date-time",
            "description": "When it went to the kitchen, so \"how long since mains were fired\" can be answered."
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "delivery_fee": {
      "type": "number"
    },
    "small_order_surcharge": {
      "type": "number",
      "default": 0
    },
    "discount": {
      "type": "number"
    },
    "discount_reason_code": {
      "type": "string"
    },
    "coupon_code": {
      "type": "string",
      "description": "LEGACY: Single coupon code for backward compatibility."
    },
    "coupon_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "CURRENT: Array of up to 3 validated coupon codes."
    },
    "total": {
      "type": "number"
    },
    "platform_commission_amount": {
      "type": "number"
    },
    "restaurant_earnings": {
      "type": "number"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "card",
        "apple_pay",
        "google_pay",
        "pay_at_counter"
      ],
      "default": "cash"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending_payment",
        "payment_confirmed",
        "paid_card",
        "failed_payment",
        "cancelled_payment"
      ],
      "default": "pending_payment"
    },
    "order_status": {
      "type": "string",
      "enum": [
        "new",
        "confirmed",
        "preparing",
        "ready",
        "completed",
        "cancelled"
      ],
      "default": "new"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "preparing",
        "out_for_delivery",
        "ready_for_collection",
        "delivered",
        "collected",
        "cancelled",
        "refund_requested",
        "refund_rejected_by_restaurant",
        "refund_under_platform_review",
        "refunded"
      ],
      "default": "pending"
    },
    "order_type": {
      "type": "string",
      "enum": [
        "delivery",
        "collection",
        "takeaway",
        "dine_in"
      ],
      "default": "delivery"
    },
    "table_id": {
      "type": "string"
    },
    "table_number": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string"
    },
    "refund_request_date": {
      "type": "string",
      "format": "date-time"
    },
    "refund_request_reason": {
      "type": "string"
    },
    "refund_request_description": {
      "type": "string"
    },
    "refund_request_type": {
      "type": "string",
      "enum": [
        "full",
        "partial"
      ]
    },
    "refund_requested_amount": {
      "type": "number"
    },
    "refund_requested_items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "refund_rejection_reason": {
      "type": "string"
    },
    "refund_rejected_date": {
      "type": "string",
      "format": "date-time"
    },
    "refund_approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "refund_amount": {
      "type": "number"
    },
    "refund_paid_by": {
      "type": "string",
      "enum": [
        "restaurant",
        "platform"
      ]
    },
    "platform_override_reason": {
      "type": "string"
    },
    "platform_override_date": {
      "type": "string",
      "format": "date-time"
    },
    "platform_override_by": {
      "type": "string"
    },
    "status_history": {
      "type": "array",
      "description": "Track all status changes",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "payment_audit_trail": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "payment_confirmed_at_counter"
            ]
          },
          "actor_email": {
            "type": "string"
          },
          "actor_name": {
            "type": "string"
          },
          "actor_role": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "payment_confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "payment_confirmed_by": {
      "type": "string"
    },
    "delivery_address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "estimated_delivery": {
      "type": "string"
    },
    "actual_delivery_time": {
      "type": "string"
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time"
    },
    "is_scheduled": {
      "type": "boolean",
      "default": false
    },
    "group_order_id": {
      "type": "string"
    },
    "is_group_order": {
      "type": "boolean",
      "default": false
    },
    "group_order_host": {
      "type": "string"
    },
    "guest_name": {
      "type": "string"
    },
    "guest_email": {
      "type": "string"
    },
    "loyalty_points_earned": {
      "type": "number",
      "default": 0
    },
    "loyalty_points_awarded": {
      "type": "boolean",
      "default": false
    },
    "third_party_platform": {
      "type": "string"
    },
    "third_party_order_id": {
      "type": "string"
    },
    "offline_id": {
      "type": "string"
    },
    "offline_created": {
      "type": "boolean",
      "default": false
    },
    "offline_created_at": {
      "type": "string",
      "format": "date-time"
    },
    "offline_created_by": {
      "type": "string"
    },
    "offline_created_by_name": {
      "type": "string"
    },
    "offline_created_by_role": {
      "type": "string"
    },
    "offline_synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "needs_review": {
      "type": "boolean",
      "default": false
    },
    "sync_validation_notes": {
      "type": "string"
    },
    "offline_review_status": {
      "type": "string",
      "enum": [
        "new",
        "acknowledged",
        "resolved",
        "escalated"
      ]
    },
    "offline_review_by": {
      "type": "string"
    },
    "offline_review_at": {
      "type": "string",
      "format": "date-time"
    },
    "offline_review_reason_code": {
      "type": "string",
      "enum": [
        "price_adjusted_on_sync",
        "acceptable_policy_override",
        "customer_already_served",
        "minor_discrepancy",
        "potential_abuse",
        "large_price_mismatch",
        "repeated_offline_issues",
        "needs_refund_followup",
        "other"
      ]
    },
    "offline_review_notes": {
      "type": "string"
    }
  },
  "required": [
    "restaurant_id",
    "items",
    "total"
  ]
}