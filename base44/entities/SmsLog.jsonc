{
  "name": "SmsLog",
  "type": "object",
  "properties": {
    "restaurant_id": {
      "type": "string",
      "description": "Restaurant that triggered this SMS"
    },
    "restaurant_name": {
      "type": "string",
      "description": "Restaurant name for display"
    },
    "to": {
      "type": "string",
      "description": "Recipient phone number"
    },
    "message": {
      "type": "string",
      "description": "SMS message body"
    },
    "order_id": {
      "type": "string",
      "description": "Related order ID if applicable"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "failed",
        "simulated",
        "uncertain",
        "pending",
        "delivered",
        "expired"
      ],
      "default": "sent",
      "description": "sent=provider confirmed send, failed=provider rejected, simulated=no provider configured, uncertain=ambiguous result (no fallback applied), pending=HTTPSMS accepted awaiting webhook, delivered=confirmed delivered via webhook, expired=HTTPSMS message expired before send"
    },
    "message_sid": {
      "type": "string",
      "description": "Legacy Twilio message SID on success (kept for backward compatibility)"
    },
    "error_details": {
      "type": "string",
      "description": "Error details if failed"
    },
    "type": {
      "type": "string",
      "enum": [
        "customer_notification",
        "restaurant_alert",
        "other"
      ],
      "default": "customer_notification",
      "description": "Type of SMS"
    },
    "provider": {
      "type": "string",
      "enum": [
        "httpsms",
        "twilio",
        "none"
      ],
      "description": "SMS provider that handled (or attempted) this message"
    },
    "provider_message_id": {
      "type": "string",
      "description": "Message ID returned by the provider (HTTPSMS data.id or Twilio message SID)"
    },
    "request_id": {
      "type": "string",
      "description": "HTTPSMS request_id used for idempotency tracking and webhook correlation"
    },
    "is_fallback": {
      "type": "boolean",
      "default": false,
      "description": "True if this provider was used as a fallback (e.g. Twilio after HTTPSMS failure)"
    },
    "failure_reason": {
      "type": "string",
      "description": "Reason for provider failure (logged before fallback attempt or from webhook event)"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Deterministic key to prevent duplicate SMS (order_id + type + recipient)"
    },
    "fallback_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "sent",
        "failed",
        "skipped"
      ],
      "default": "none",
      "description": "Tracks async Twilio fallback state for HTTPSMS messages: none=not needed, pending=atomically claimed (Twilio being called), sent=Twilio succeeded, failed=Twilio failed, skipped=Twilio not configured or message already terminal"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time",
      "description": "When delivery was confirmed via HTTPSMS webhook (message.phone.delivered event)"
    }
  },
  "required": [
    "to",
    "message",
    "status"
  ]
}