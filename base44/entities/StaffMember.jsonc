{
  "name": "StaffMember",
  "type": "object",
  "properties": {
    "restaurant_id": {
      "type": "string",
      "description": "Restaurant this staff member belongs to"
    },
    "full_name": {
      "type": "string",
      "description": "Staff member full name"
    },
    "email": {
      "type": "string",
      "description": "Staff member login email"
    },
    "staff_number": {
      "type": "string",
      "description": "Short unique identifier e.g. S001 used for POS login"
    },
    "role": {
      "type": "string",
      "enum": [
        "waiter",
        "cashier",
        "kitchen_staff",
        "manager"
      ],
      "description": "Staff role"
    },
    "pin": {
      "type": "string",
      "description": "DEPRECATED - legacy plaintext PIN. Was readable by any authenticated browser session via the entity API, exposing every colleague's PIN including managers'. Migrated to pin_hash on first successful login and then cleared. Never write to this field."
    },
    "pin_hash": {
      "type": "string",
      "description": "PBKDF2-SHA256 hash of the PIN. Set and verified only by posVerifyStaffPin; never compared client-side."
    },
    "pin_salt": {
      "type": "string",
      "description": "Random per-staff salt. Without a unique salt, identical PINs (staff commonly all use 0000) produce identical hashes, so cracking one cracks them all."
    },
    "pin_failed_attempts": {
      "type": "number",
      "default": 0,
      "description": "Consecutive failed PIN attempts. A 4-digit PIN is only 10,000 combinations, so throttling matters more than hashing."
    },
    "pin_locked_until": {
      "type": "string",
      "format": "date-time",
      "description": "Lockout expiry after repeated failures. Cleared on a successful login."
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "invite_sent": {
      "type": "boolean",
      "default": false
    },
    "invite_token": {
      "type": "string"
    },
    "invite_token_expires": {
      "type": "string",
      "format": "date-time"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "restaurant_id",
    "full_name",
    "role"
  ]
}