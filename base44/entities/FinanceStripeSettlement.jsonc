{
  "name": "FinanceStripeSettlement",
  "properties": {
    "amount": {
      "default": 0,
      "type": "number"
    },
    "arrival_date": {
      "format": "date-time",
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "currency": {
      "default": "gbp",
      "type": "string"
    },
    "external_reference": {
      "type": "string"
    },
    "gross_balance_transactions": {
      "default": 0,
      "type": "number"
    },
    "livemode": {
      "default": false,
      "type": "boolean"
    },
    "net_balance_transactions": {
      "default": 0,
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "payout_date": {
      "format": "date-time",
      "type": "string"
    },
    "payout_reference": {
      "type": "string"
    },
    "reconciliation_status": {
      "default": "imported",
      "enum": [
        "imported",
        "matched",
        "query"
      ],
      "type": "string"
    },
    "source_type": {
      "default": "stripe_api",
      "enum": [
        "stripe_api"
      ],
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "stripe_fees": {
      "default": 0,
      "type": "number"
    },
    "stripe_payout_id": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "stripe_payout_id",
    "amount",
    "reconciliation_status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "finance_backend_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "finance_backend_only"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "finance_backend_only"
      }
    }
  },
  "type": "object"
}