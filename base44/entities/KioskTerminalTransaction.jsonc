{
  "name": "KioskTerminalTransaction",
  "type": "object",
  "properties": {
    "restaurant_id": {
      "type": "string",
      "description": "Restaurant ID operating the kiosk"
    },
    "kiosk_id": {
      "type": "string",
      "description": "Unique identifier for the kiosk device"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "idle",
        "offline",
        "error"
      ],
      "description": "Current kiosk status"
    },
    "order_count": {
      "type": "number",
      "default": 0,
      "description": "Number of orders processed since last report"
    },
    "last_activity": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last user activity on kiosk"
    },
    "reported_at": {
      "type": "string",
      "format": "date-time",
      "description": "When kiosk reported its status"
    },
    "device_type": {
      "type": "string",
      "default": "kiosk",
      "description": "Type of device (kiosk, pos, tablet)"
    }
  },
  "required": [
    "restaurant_id",
    "kiosk_id",
    "status"
  ]
}