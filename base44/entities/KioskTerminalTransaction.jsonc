{
  "name": "KioskTerminalTransaction",
  "type": "object",
  "properties": {
    "transaction_ref": {
      "type": "string",
      "description": "Unique reference generated by the kiosk session before calling the terminal. Used as the trust anchor."
    },
    "restaurant_id": {
      "type": "string",
      "description": "Restaurant that owns this terminal session"
    },
    "amount": {
      "type": "number",
      "description": "Authorized amount in GBP, as confirmed by the terminal"
    },
    "status": {
      "type": "string",
      "enum": [
        "approved",
        "declined",
        "failed",
        "redeemed"
      ],
      "description": "Terminal authorization outcome. 'redeemed' = order has been created against this transaction."
    },
    "provider": {
      "type": "string",
      "description": "Terminal provider (stripe_terminal, sumup, square, worldpay, simulation)"
    },
    "terminal_label": {
      "type": "string",
      "description": "Human-readable terminal label from restaurant config"
    },
    "authorized_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the terminal authorization was confirmed"
    },
    "redeemed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When an order was created consuming this authorization"
    },
    "order_id": {
      "type": "string",
      "description": "Order ID created against this authorization (set on redemption)"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "After this timestamp the authorization is no longer valid for order creation (10 min window)"
    }
  },
  "required": [
    "transaction_ref",
    "restaurant_id",
    "amount",
    "status"
  ]
}