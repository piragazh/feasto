{
  "name": "MenuItem",
  "type": "object",
  "properties": {
    "restaurant_id": {
      "type": "string",
      "description": "Reference to restaurant"
    },
    "allergens_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "A PERSON has checked this item's allergens. Until this is true, customers are told the information isn't available - an empty allergens list means nobody has said, NOT that the food is free of allergens. AI suggestions never set this."
    },
    "allergens_confirmed_by": {
      "type": "string",
      "description": "Who confirmed the allergens. The business is legally responsible for accuracy, so the declaration is attributable."
    },
    "allergens_confirmed_at": { "type": "string", "format": "date-time" },
    "allergens_source": {
      "type": "string",
      "enum": ["manual", "ai_suggested"],
      "description": "Where the list came from. 'ai_suggested' is a guess from the item's name and description and is never shown to customers until confirmed."
    },
    "allergen_notes": {
      "type": "string",
      "description": "Free text shown with the allergens, e.g. 'fried in shared oil with fish'."
    },
    "track_stock": {
      "type": "boolean",
      "default": false,
      "description": "Opt-in. When false (the default) stock is ignored entirely, so existing menus are unaffected."
    },
    "stock_quantity": {
      "type": "number",
      "description": "Portions on hand. Decremented by the applyOrderStock function on EVERY order path - till, offline, kiosk, QR, online and marketplaces - so it cannot drift by channel."
    },
    "low_stock_threshold": {
      "type": "number",
      "description": "Warn when stock falls to this level. 0 or empty means no low-stock warning."
    },
    "auto_86ed": {
      "type": "boolean",
      "default": false,
      "description": "True when the item was taken off sale AUTOMATICALLY by reaching zero stock. Distinguishes it from a manager switching it off by hand, so a void or restock can bring an auto-86ed item back without overriding a deliberate decision."
    },
    "availability_windows": {
      "type": "array",
      "description": "When this item can be ordered, e.g. breakfast 07:00-11:30. Empty means always available - scheduling is opt-in so existing menus are unaffected. Times are the restaurant's LOCAL time (Europe/London); see src/lib/pos-schedule-logic.js for why this matters across BST.",
      "items": {
        "type": "object",
        "properties": {
          "days": { "type": "array", "items": { "type": "number" }, "description": "0=Sunday ... 6=Saturday. Empty means every day." },
          "start": { "type": "string", "description": "HH:MM, restaurant local time" },
          "end": { "type": "string", "description": "HH:MM, local, exclusive. Earlier than start means the window crosses midnight." }
        }
      }
    },
    "price_windows": {
      "type": "array",
      "description": "Timed prices, e.g. happy hour. Enforced SERVER-SIDE in posCreateOrder so a till with a stale screen or wrong clock cannot charge a happy-hour price after it ends. A timed price can only lower the price; where windows overlap the lowest applies.",
      "items": {
        "type": "object",
        "properties": {
          "days": { "type": "array", "items": { "type": "number" }, "description": "0=Sunday ... 6=Saturday. Empty means every day." },
          "start": { "type": "string", "description": "HH:MM, restaurant local time" },
          "end": { "type": "string", "description": "HH:MM, local, exclusive. Earlier than start means the window crosses midnight." },
          "price": { "type": "number", "description": "Price charged during this window. Must be below the normal price to have any effect." },
          "label": { "type": "string", "description": "Shown on the till, e.g. Happy Hour" }
        }
      }
    },
    "pos_tile_color": {
      "type": "string",
      "enum": ["none", "red", "orange", "amber", "green", "teal", "blue", "purple", "pink"],
      "default": "none",
      "description": "Colour of this item's tile on the POS grid. Staff build speed on a menu they use daily by recognising colour before reading - e.g. all drinks blue, all sides amber. Visual only; no effect on price or availability."
    },
    "menu_item_no": {
      "type": "string",
      "description": "Menu board item number for quick POS lookup (e.g., 43, 101, A5)"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "pos_price": {
      "type": "number",
      "description": "Override price for in-store POS. If not set, uses the standard price."
    },
    "availability_channel": {
      "type": "string",
      "enum": [
        "both",
        "online_only",
        "pos_only"
      ],
      "default": "both",
      "description": "Where this item is available: both (default), online_only, or pos_only"
    },
    "image_url": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "description": "Menu category like Starters, Mains, Desserts"
    },
    "subcategory": {
      "type": "string",
      "description": "Optional subcategory within the main category"
    },
    "is_popular": {
      "type": "boolean",
      "default": false
    },
    "is_vegetarian": {
      "type": "boolean",
      "default": false
    },
    "is_spicy": {
      "type": "boolean",
      "default": false
    },
    "is_available": {
      "type": "boolean",
      "default": true,
      "description": "Whether item is currently available or temporarily out of stock"
    },
    "show_in_cart_quick_add": {
      "type": "boolean",
      "default": false,
      "description": "Show this item in quick-add section on cart screen for faster ordering"
    },
    "availability_schedule": {
      "type": "object",
      "description": "Schedule rules for when this item is available",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "days": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "time_from": {
          "type": "string"
        },
        "time_until": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "nutrition": {
      "type": "object",
      "description": "Nutritional information per serving",
      "properties": {
        "calories": {
          "type": "number"
        },
        "protein_g": {
          "type": "number"
        },
        "carbs_g": {
          "type": "number"
        },
        "fat_g": {
          "type": "number"
        },
        "saturates_g": {
          "type": "number"
        },
        "fibre_g": {
          "type": "number"
        },
        "salt_g": {
          "type": "number"
        },
        "sugar_g": {
          "type": "number"
        },
        "serving_size": {
          "type": "string"
        }
      }
    },
    "allergens": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of allergens present"
    },
    "customization_options": {
      "type": "array",
      "description": "Available customizations for this item",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "single",
              "multiple",
              "meal_upgrade"
            ]
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "max_quantity": {
            "type": "number"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "price": {
                  "type": "number"
                },
                "pos_price": {
                  "type": "number",
                  "description": "Override price for this option when ordered via POS. If not set, uses the standard price."
                }
              }
            }
          },
          "meal_customizations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "single",
                    "multiple"
                  ]
                },
                "required": {
                  "type": "boolean",
                  "default": false
                },
                "max_quantity": {
                  "type": "number"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "price": {
                        "type": "number"
                      },
                      "pos_price": {
                        "type": "number",
                        "description": "Override price for this option when ordered via POS."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "restaurant_id",
    "name",
    "price"
  ]
}