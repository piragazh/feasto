{
  "name": "Message",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string"
    },
    "restaurant_id": {
      "type": "string"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "customer",
        "restaurant"
      ],
      "description": "Who sent the message"
    },
    "message": {
      "type": "string"
    },
    "sent_by_driver_id": {
      "type": "string",
      "description": "Set server-side (driverAction) when the message was written by the delivery driver, not restaurant staff."
    },
    "is_read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "order_id",
    "restaurant_id",
    "sender_type",
    "message"
  ]
}