{
  "name": "FinanceCompany",
  "type": "object",
  "properties": {
    "legal_name": {
      "type": "string",
      "description": "Registered legal entity name"
    },
    "trading_name": {
      "type": "string",
      "description": "Trading name, if different"
    },
    "company_number": {
      "type": "string",
      "description": "UK Companies House number, if applicable"
    },
    "vat_number": {
      "type": "string",
      "description": "VAT registration number, if registered"
    },
    "address": {
      "type": "object",
      "properties": {
        "line_1": {
          "type": "string"
        },
        "line_2": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "postcode": {
          "type": "string"
        },
        "country": {
          "type": "string"
        }
      }
    },
    "currency": {
      "type": "string",
      "enum": [
        "GBP"
      ],
      "default": "GBP"
    },
    "accounting_year_start_month": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12,
      "default": 4
    },
    "accounting_year_start_day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31,
      "default": 6
    },
    "vat_scheme": {
      "type": "string",
      "enum": [
        "standard",
        "cash_accounting",
        "flat_rate",
        "annual_accounting",
        "not_registered"
      ],
      "default": "standard"
    },
    "accounting_basis": {
      "type": "string",
      "enum": [
        "accrual",
        "cash"
      ],
      "default": "accrual"
    },
    "vat_registered": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "legal_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}