{
  "name": "FinanceCompany",
  "properties": {
    "accounting_basis": {
      "default": "accrual",
      "enum": [
        "accrual",
        "cash"
      ],
      "type": "string"
    },
    "accounting_year_start_day": {
      "default": 1,
      "maximum": 31,
      "minimum": 1,
      "type": "integer"
    },
    "accounting_year_start_month": {
      "default": 4,
      "maximum": 12,
      "minimum": 1,
      "type": "integer"
    },
    "address": {
      "properties": {
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "line_1": {
          "type": "string"
        },
        "line_2": {
          "type": "string"
        },
        "postcode": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "bank_account_name": {
      "type": "string"
    },
    "bank_account_number": {
      "type": "string"
    },
    "bank_sort_code": {
      "type": "string"
    },
    "chart_seeded": {
      "default": false,
      "type": "boolean"
    },
    "company_number": {
      "description": "Companies House number",
      "type": "string"
    },
    "credit_note_prefix": {
      "default": "CN-",
      "type": "string"
    },
    "currency": {
      "default": "GBP",
      "enum": [
        "GBP"
      ],
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "invoice_footer": {
      "type": "string"
    },
    "invoice_prefix": {
      "default": "INV-",
      "type": "string"
    },
    "legal_name": {
      "description": "Registered legal entity name, e.g. MealDrop LTD",
      "type": "string"
    },
    "locked_until": {
      "description": "No postings allowed on or before this date",
      "format": "date",
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "next_credit_note_number": {
      "default": 1,
      "type": "integer"
    },
    "next_invoice_number": {
      "default": 1,
      "type": "integer"
    },
    "next_journal_number": {
      "default": 1,
      "type": "integer"
    },
    "notes": {
      "type": "string"
    },
    "payment_terms_days": {
      "default": 14,
      "type": "integer"
    },
    "phone": {
      "type": "string"
    },
    "registered_in": {
      "default": "England and Wales",
      "type": "string"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "archived"
      ],
      "type": "string"
    },
    "trading_name": {
      "type": "string"
    },
    "utr": {
      "description": "Corporation Tax UTR",
      "type": "string"
    },
    "vat_number": {
      "type": "string"
    },
    "vat_registered": {
      "default": false,
      "type": "boolean"
    },
    "vat_registration_date": {
      "format": "date",
      "type": "string"
    },
    "vat_scheme": {
      "default": "not_registered",
      "enum": [
        "standard",
        "cash_accounting",
        "flat_rate",
        "annual_accounting",
        "not_registered"
      ],
      "type": "string"
    },
    "vat_threshold": {
      "default": 90000,
      "type": "number"
    },
    "website": {
      "type": "string"
    }
  },
  "required": [
    "legal_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "finance_backend_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "finance_backend_only"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "finance_backend_only"
      }
    }
  },
  "type": "object"
}