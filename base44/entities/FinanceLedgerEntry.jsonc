{
  "name": "FinanceLedgerEntry",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "currency": {
      "default": "GBP",
      "enum": [
        "GBP"
      ],
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "entry_date": {
      "format": "date",
      "type": "string"
    },
    "entry_number": {
      "type": "string"
    },
    "lines": {
      "items": {
        "properties": {
          "account_code": {
            "type": "string"
          },
          "account_name": {
            "type": "string"
          },
          "credit": {
            "type": "number"
          },
          "debit": {
            "type": "number"
          },
          "memo": {
            "type": "string"
          },
          "tax_code": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "posted_at": {
      "format": "date-time",
      "type": "string"
    },
    "posted_by": {
      "type": "string"
    },
    "reversed_entry_id": {
      "description": "On a reversed entry: the reversal that cancels it",
      "type": "string"
    },
    "reverses_entry_id": {
      "description": "On a reversal: the entry it cancels",
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "source_reference": {
      "type": "string"
    },
    "source_type": {
      "enum": [
        "invoice",
        "credit_note",
        "payment",
        "expense",
        "expense_payment",
        "payout",
        "journal",
        "opening_balance",
        "reversal"
      ],
      "type": "string"
    },
    "status": {
      "default": "posted",
      "enum": [
        "posted",
        "reversed"
      ],
      "type": "string"
    },
    "total_credit": {
      "default": 0,
      "type": "number"
    },
    "total_debit": {
      "default": 0,
      "type": "number"
    }
  },
  "required": [
    "company_id",
    "entry_date",
    "source_type",
    "description",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "finance_backend_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "finance_backend_only"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "finance_backend_only"
      }
    }
  },
  "type": "object"
}