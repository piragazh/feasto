{
  "name": "FinancePayout",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "FinanceCompany record ID"
    },
    "payout_reference": {
      "type": "string"
    },
    "payout_date": {
      "type": "string",
      "format": "date"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "payment_provider": {
      "type": "string",
      "description": "Stripe, bank, or other provider"
    },
    "restaurant_name": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "enum": [
        "GBP"
      ],
      "default": "GBP"
    },
    "gross_order_value": {
      "type": "number",
      "default": 0
    },
    "commission_rate": {
      "type": "number",
      "default": 0
    },
    "commission_amount": {
      "type": "number",
      "default": 0
    },
    "commission_vat": {
      "type": "number",
      "default": 0
    },
    "refunds_and_chargebacks": {
      "type": "number",
      "default": 0
    },
    "other_deductions": {
      "type": "number",
      "default": 0
    },
    "net_payout": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "expected",
        "processing",
        "paid",
        "reconciled",
        "query"
      ],
      "default": "expected"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "manual",
        "csv_import",
        "provider_import"
      ],
      "default": "manual"
    },
    "external_reference": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "payout_reference",
    "payout_date",
    "restaurant_name",
    "net_payout",
    "status"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}