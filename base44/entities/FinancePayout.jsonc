{
  "name": "FinancePayout",
  "properties": {
    "commission_amount": {
      "default": 0,
      "type": "number"
    },
    "commission_rate": {
      "default": 0,
      "type": "number"
    },
    "commission_vat": {
      "default": 0,
      "type": "number"
    },
    "company_id": {
      "type": "string"
    },
    "currency": {
      "default": "GBP",
      "enum": [
        "GBP"
      ],
      "type": "string"
    },
    "external_reference": {
      "type": "string"
    },
    "gross_order_value": {
      "default": 0,
      "type": "number"
    },
    "net_payout": {
      "default": 0,
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "other_deductions": {
      "default": 0,
      "type": "number"
    },
    "payment_provider": {
      "type": "string"
    },
    "payout_date": {
      "format": "date",
      "type": "string"
    },
    "payout_reference": {
      "type": "string"
    },
    "period_end": {
      "format": "date",
      "type": "string"
    },
    "period_start": {
      "format": "date",
      "type": "string"
    },
    "refunds_and_chargebacks": {
      "default": 0,
      "type": "number"
    },
    "restaurant_id": {
      "type": "string"
    },
    "restaurant_name": {
      "type": "string"
    },
    "source_type": {
      "default": "manual",
      "enum": [
        "manual",
        "csv_import",
        "provider_import"
      ],
      "type": "string"
    },
    "status": {
      "default": "expected",
      "enum": [
        "expected",
        "processing",
        "paid",
        "reconciled",
        "query"
      ],
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "payout_reference",
    "payout_date",
    "restaurant_name",
    "net_payout",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "finance_backend_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "finance_backend_only"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "finance_backend_only"
      }
    }
  },
  "type": "object"
}