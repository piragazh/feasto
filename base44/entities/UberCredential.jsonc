{
  "name": "UberCredential",
  "description": "Server-only cache of MealDrop's Uber Eats application (client_credentials) access token. Uber tokens last 30 days and only 100 may be minted per hour, so the token is stored and reused across function cold starts instead of being requested per order. Readable by platform admins only; functions use the service role.",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Which token this row holds, e.g. client_credentials:production"
    },
    "access_token": {
      "type": "string",
      "description": "The bearer token. Never sent to a browser."
    },
    "scope": {
      "type": "string",
      "description": "Space-delimited scopes the token was issued for. A change of UBER_EATS_SCOPES forces a new token."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}