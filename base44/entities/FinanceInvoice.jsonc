{
  "name": "FinanceInvoice",
  "properties": {
    "amount_paid": {
      "default": 0,
      "type": "number"
    },
    "attachment_url": {
      "type": "string"
    },
    "balance_due": {
      "default": 0,
      "type": "number"
    },
    "company_id": {
      "type": "string"
    },
    "company_snapshot": {
      "description": "Seller details frozen at issue",
      "type": "object"
    },
    "credit_of_invoice_id": {
      "description": "For credit notes: the invoice being credited",
      "type": "string"
    },
    "credit_of_invoice_number": {
      "type": "string"
    },
    "credited_amount": {
      "default": 0,
      "type": "number"
    },
    "currency": {
      "default": "GBP",
      "enum": [
        "GBP"
      ],
      "type": "string"
    },
    "customer_address": {
      "properties": {
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "line_1": {
          "type": "string"
        },
        "line_2": {
          "type": "string"
        },
        "postcode": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "customer_address_text": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "document_type": {
      "default": "sales_invoice",
      "enum": [
        "sales_invoice",
        "credit_note"
      ],
      "type": "string"
    },
    "due_date": {
      "format": "date",
      "type": "string"
    },
    "gross_total": {
      "default": 0,
      "type": "number"
    },
    "internal_notes": {
      "type": "string"
    },
    "invoice_number": {
      "description": "Assigned sequentially when issued; drafts have none",
      "type": "string"
    },
    "issue_date": {
      "format": "date",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "type": "string"
    },
    "ledger_entry_id": {
      "type": "string"
    },
    "lines": {
      "items": {
        "properties": {
          "account_code": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "discount_percent": {
            "type": "number"
          },
          "gross_amount": {
            "type": "number"
          },
          "item_id": {
            "type": "string"
          },
          "net_amount": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "unit_price": {
            "type": "number"
          },
          "vat_amount": {
            "type": "number"
          },
          "vat_rate": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "net_total": {
      "default": 0,
      "type": "number"
    },
    "notes": {
      "description": "Shown on the invoice",
      "type": "string"
    },
    "recurring_id": {
      "type": "string"
    },
    "reference": {
      "description": "Job / PO / site reference",
      "type": "string"
    },
    "restaurant_id": {
      "type": "string"
    },
    "sent_at": {
      "format": "date-time",
      "type": "string"
    },
    "sent_to": {
      "type": "string"
    },
    "source_order_id": {
      "type": "string"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "issued",
        "part_paid",
        "paid",
        "void"
      ],
      "type": "string"
    },
    "supply_date": {
      "format": "date",
      "type": "string"
    },
    "vat_total": {
      "default": 0,
      "type": "number"
    },
    "void_ledger_entry_id": {
      "type": "string"
    },
    "void_reason": {
      "type": "string"
    },
    "voided_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "document_type",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "finance_backend_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "finance_backend_only"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "finance_backend_only"
      }
    }
  },
  "type": "object"
}