{
  "name": "Payout",
  "properties": {
    "cancelled_orders": {
      "default": 0,
      "type": "number"
    },
    "cancelled_orders_value": {
      "default": 0,
      "type": "number"
    },
    "card_payment_amount": {
      "default": 0,
      "type": "number"
    },
    "cash_payment_amount": {
      "default": 0,
      "type": "number"
    },
    "collection_earnings": {
      "default": 0,
      "type": "number"
    },
    "collection_orders": {
      "default": 0,
      "type": "number"
    },
    "commission_rate": {
      "type": "number"
    },
    "commission_type": {
      "default": "percentage",
      "enum": [
        "percentage",
        "fixed"
      ],
      "type": "string"
    },
    "delivery_earnings": {
      "default": 0,
      "type": "number"
    },
    "delivery_orders": {
      "default": 0,
      "type": "number"
    },
    "dine_in_orders": {
      "default": 0,
      "type": "number"
    },
    "finance_commission_entry_id": {
      "type": "string"
    },
    "finance_payment_entry_id": {
      "type": "string"
    },
    "gross_earnings": {
      "type": "number"
    },
    "net_payout": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "paid_date": {
      "format": "date-time",
      "type": "string"
    },
    "payment_method": {
      "type": "string"
    },
    "payout_frequency": {
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "custom"
      ],
      "type": "string"
    },
    "period_end": {
      "description": "Payout period end date",
      "format": "date",
      "type": "string"
    },
    "period_start": {
      "description": "Payout period start date",
      "format": "date",
      "type": "string"
    },
    "platform_commission": {
      "type": "number"
    },
    "refunded_orders_count": {
      "default": 0,
      "type": "number"
    },
    "refunds_paid_by_platform": {
      "default": 0,
      "description": "Refunds MealDrop absorbed (not deducted from restaurant)",
      "type": "number"
    },
    "refunds_paid_by_restaurant": {
      "default": 0,
      "description": "Refunds deducted from restaurant (orders paid out in an earlier period)",
      "type": "number"
    },
    "restaurant_id": {
      "description": "Restaurant receiving payout",
      "type": "string"
    },
    "restaurant_name": {
      "type": "string"
    },
    "shortfall_amount": {
      "default": 0,
      "description": "Amount the restaurant owes MealDrop when deductions exceed card takings",
      "type": "number"
    },
    "status": {
      "default": "pending",
      "enum": [
        "pending",
        "processing",
        "paid",
        "failed",
        "voided"
      ],
      "type": "string"
    },
    "total_orders": {
      "type": "number"
    },
    "transaction_reference": {
      "type": "string"
    },
    "void_reason": {
      "type": "string"
    },
    "voided_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "restaurant_id",
    "period_start",
    "period_end",
    "gross_earnings",
    "platform_commission",
    "net_payout"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "finance_backend_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "finance_backend_only"
      }
    }
  },
  "type": "object"
}