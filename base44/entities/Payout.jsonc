{
  "name": "Payout",
  "properties": {
    "adjustment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "PayoutAdjustment records settled in this payout."
    },
    "adjustments_total": {
      "default": 0,
      "type": "number"
    },
    "chargebacks_amount": {
      "default": 0,
      "type": "number",
      "description": "Chargebacks and Stripe dispute fees (negative) or dispute wins (positive)."
    },
    "manual_adjustments_amount": {
      "default": 0,
      "type": "number"
    },
    "reserve_held": {
      "default": 0,
      "type": "number",
      "description": "Held back from this payout; paid later by a reserve_release adjustment."
    },
    "reserve_released_amount": {
      "default": 0,
      "type": "number"
    },
    "reserve_percent": {
      "type": "number"
    },
    "reserve_until": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "batch_id": {
      "type": "string",
      "description": "Bank payment file (batch) this payout was exported in."
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "paid_to_account": {
      "type": "string",
      "description": "Masked bank details used for the export."
    },
    "order_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Online orders this payout paid for. An order is paid once it appears in a live (not voided/failed) payout; voiding releases it. Kept here, not on Order, so payouts never re-fire Order workflows."
    },
    "refund_order_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Refunded orders settled in this payout (deducted, covered by MealDrop, or handled in cash), so a refund is never counted twice."
    },
    "late_orders": {
      "default": 0,
      "type": "number",
      "description": "Orders from before period_start that were completed after their own period was paid."
    },
    "held_orders": {
      "default": 0,
      "type": "number",
      "description": "Orders up to period_end not yet completed or with a refund pending - paid in a later payout."
    },
    "held_orders_value": {
      "default": 0,
      "type": "number"
    },
    "unpaid_card_orders": {
      "default": 0,
      "type": "number",
      "description": "Completed card orders whose payment never went through - excluded."
    },
    "unpaid_card_value": {
      "default": 0,
      "type": "number"
    },
    "cash_refunds_not_deducted": {
      "default": 0,
      "type": "number",
      "description": "Restaurant-borne refunds on cash orders - handed back by the restaurant, so not deducted."
    },
    "brought_forward_amount": {
      "default": 0,
      "type": "number",
      "description": "Previous payout's shortfall recovered in this one."
    },
    "fixed_commission_amount": {
      "type": "number",
      "description": "Monthly fixed fee in force when generated (fixed commission only)."
    },
    "commission_months": {
      "type": "number",
      "description": "Calendar months whose month-end falls in this period - one fixed fee each."
    },
    "generated_by": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancelled_orders": {
      "default": 0,
      "type": "number"
    },
    "cancelled_orders_value": {
      "default": 0,
      "type": "number"
    },
    "card_payment_amount": {
      "default": 0,
      "type": "number"
    },
    "cash_payment_amount": {
      "default": 0,
      "type": "number"
    },
    "collection_earnings": {
      "default": 0,
      "type": "number"
    },
    "collection_orders": {
      "default": 0,
      "type": "number"
    },
    "commission_rate": {
      "type": "number"
    },
    "commission_type": {
      "default": "percentage",
      "enum": [
        "percentage",
        "fixed"
      ],
      "type": "string"
    },
    "delivery_earnings": {
      "default": 0,
      "type": "number"
    },
    "delivery_orders": {
      "default": 0,
      "type": "number"
    },
    "dine_in_orders": {
      "default": 0,
      "type": "number"
    },
    "finance_commission_entry_id": {
      "type": "string"
    },
    "finance_payment_entry_id": {
      "type": "string"
    },
    "gross_earnings": {
      "type": "number"
    },
    "net_payout": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "paid_date": {
      "format": "date-time",
      "type": "string"
    },
    "payment_method": {
      "type": "string"
    },
    "payout_frequency": {
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "custom"
      ],
      "type": "string"
    },
    "period_end": {
      "description": "Payout period end date",
      "format": "date",
      "type": "string"
    },
    "period_start": {
      "description": "Payout period start date",
      "format": "date",
      "type": "string"
    },
    "platform_commission": {
      "type": "number"
    },
    "refunded_orders_count": {
      "default": 0,
      "type": "number"
    },
    "refunds_paid_by_platform": {
      "default": 0,
      "description": "Refunds MealDrop absorbed (not deducted from restaurant)",
      "type": "number"
    },
    "refunds_paid_by_restaurant": {
      "default": 0,
      "description": "Refunds deducted from restaurant (orders paid out in an earlier period)",
      "type": "number"
    },
    "restaurant_id": {
      "description": "Restaurant receiving payout",
      "type": "string"
    },
    "restaurant_name": {
      "type": "string"
    },
    "shortfall_amount": {
      "default": 0,
      "description": "Amount the restaurant owes MealDrop when deductions exceed card takings",
      "type": "number"
    },
    "status": {
      "default": "pending",
      "enum": [
        "awaiting_approval",
        "pending",
        "processing",
        "paid",
        "failed",
        "voided"
      ],
      "type": "string"
    },
    "total_orders": {
      "type": "number"
    },
    "transaction_reference": {
      "type": "string"
    },
    "void_reason": {
      "type": "string"
    },
    "voided_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "restaurant_id",
    "period_start",
    "period_end",
    "gross_earnings",
    "platform_commission",
    "net_payout"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "finance_backend_only"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "finance_backend_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "finance_backend_only"
      }
    }
  },
  "type": "object"
}