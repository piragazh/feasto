{
  "name": "LoyaltyPoints",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User email for registered users, or 'phone:PHONENUMBER' for guests"
    },
    "phone": {
      "type": "string",
      "description": "Normalized phone number (digits only) for guest users"
    },
    "points_earned": {
      "type": "number",
      "default": 0,
      "description": "Total points ever earned"
    },
    "points_redeemed": {
      "type": "number",
      "default": 0,
      "description": "Total points redeemed"
    },
    "total_points": {
      "type": "number",
      "default": 0,
      "description": "Current available points balance"
    },
    "orders_count": {
      "type": "number",
      "default": 0,
      "description": "Number of qualifying orders"
    },
    "merged_into": {
      "type": "string",
      "description": "Set when a phone-keyed guest balance has been merged into an account balance. The record is kept at zero rather than deleted, so the merge is auditable and can never be applied twice."
    },
    "merged_at": { "type": "string", "format": "date-time" },
    "tier": {
      "type": "string",
      "enum": [
        "bronze",
        "silver",
        "gold"
      ],
      "default": "bronze"
    }
  },
  "required": [
    "user_email"
  ]
}