{
  "name": "FinanceOrderCommission",
  "properties": {
    "commission_amount": {
      "default": 0,
      "type": "number"
    },
    "commission_rate": {
      "default": 0,
      "type": "number"
    },
    "commission_vat": {
      "default": 0,
      "type": "number"
    },
    "company_id": {
      "type": "string"
    },
    "currency": {
      "default": "GBP",
      "enum": [
        "GBP"
      ],
      "type": "string"
    },
    "gross_order_value": {
      "default": 0,
      "type": "number"
    },
    "ledger_entry_id": {
      "description": "Receipt posting (money into Stripe balance)",
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "order_date": {
      "format": "date-time",
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "order_number": {
      "type": "string"
    },
    "order_source": {
      "type": "string"
    },
    "order_status": {
      "type": "string"
    },
    "payment_intent_id": {
      "type": "string"
    },
    "payment_method": {
      "type": "string"
    },
    "payment_status": {
      "type": "string"
    },
    "reconciliation_status": {
      "default": "recorded",
      "enum": [
        "recorded",
        "matched",
        "query",
        "excluded"
      ],
      "type": "string"
    },
    "refund_amount": {
      "default": 0,
      "type": "number"
    },
    "refund_entry_id": {
      "type": "string"
    },
    "refund_paid_by": {
      "type": "string"
    },
    "refunded_at": {
      "format": "date-time",
      "type": "string"
    },
    "restaurant_earnings": {
      "default": 0,
      "type": "number"
    },
    "restaurant_id": {
      "type": "string"
    },
    "restaurant_name": {
      "type": "string"
    },
    "source_type": {
      "default": "order_sync",
      "enum": [
        "order_sync"
      ],
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "order_id",
    "gross_order_value",
    "commission_amount",
    "reconciliation_status"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "finance_backend_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "finance_backend_only"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "finance_backend_only"
      }
    }
  }
}