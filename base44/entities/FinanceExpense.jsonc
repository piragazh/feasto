{
  "name": "FinanceExpense",
  "properties": {
    "account_code": {
      "description": "Expense or asset account",
      "type": "string"
    },
    "amount_paid": {
      "default": 0,
      "type": "number"
    },
    "category": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "currency": {
      "default": "GBP",
      "enum": [
        "GBP"
      ],
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "due_date": {
      "format": "date",
      "type": "string"
    },
    "expense_date": {
      "format": "date",
      "type": "string"
    },
    "gross_amount": {
      "type": "number"
    },
    "ledger_entry_id": {
      "type": "string"
    },
    "linked_invoice_id": {
      "description": "Customer invoice this cost was recharged on",
      "type": "string"
    },
    "net_amount": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "paid_from_account": {
      "description": "Bank / cash / director loan account code",
      "type": "string"
    },
    "payment_date": {
      "format": "date",
      "type": "string"
    },
    "payment_ledger_entry_id": {
      "type": "string"
    },
    "payment_status": {
      "default": "unpaid",
      "enum": [
        "unpaid",
        "paid",
        "void"
      ],
      "type": "string"
    },
    "receipt_url": {
      "type": "string"
    },
    "supplier_invoice_number": {
      "type": "string"
    },
    "supplier_name": {
      "type": "string"
    },
    "vat_amount": {
      "type": "number"
    },
    "vat_rate": {
      "type": "number"
    },
    "vat_reclaimable": {
      "default": false,
      "type": "boolean"
    },
    "void_ledger_entry_id": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "expense_date",
    "description",
    "gross_amount",
    "payment_status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "finance_backend_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "finance_backend_only"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "finance_backend_only"
      }
    }
  },
  "type": "object"
}