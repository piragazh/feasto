{
  "name": "PaymentTransaction",
  "description": "Complete payment transaction audit trail with refund tracking",
  "type": "object",
  "properties": {
    "payment_intent_id": {
      "type": "string",
      "description": "Stripe PaymentIntent ID (dedup key)"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Client-supplied idempotency key"
    },
    "restaurant_id": {
      "type": "string",
      "description": "Reference to restaurant"
    },
    "order_id": {
      "type": "string",
      "description": "Reference to created Order (populated after order creation)"
    },
    "amount": {
      "type": "number",
      "description": "Amount in GBP"
    },
    "currency": {
      "type": "string",
      "default": "gbp",
      "description": "Currency code"
    },
    "user_email": {
      "type": "string",
      "description": "Authenticated user email (null for guests)"
    },
    "guest_email": {
      "type": "string",
      "description": "Guest email if not authenticated"
    },
    "guest_phone": {
      "type": "string",
      "description": "Guest phone if not authenticated"
    },
    "status": {
      "type": "string",
      "enum": [
        "authorized",
        "order_created",
        "refunded",
        "needs_review"
      ],
      "description": "Payment transaction status"
    },
    "failure_reason": {
      "type": "string",
      "description": "Reason if payment failed or refund failed"
    },
    "stripe_verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When Stripe payment was verified"
    },
    "order_created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When order was created"
    },
    "refund_id": {
      "type": "string",
      "description": "Stripe refund ID if refunded"
    },
    "refund_amount": {
      "type": "number",
      "description": "Amount refunded in GBP"
    },
    "refund_attempted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When refund was first attempted"
    },
    "refund_confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When refund was confirmed complete"
    }
  },
  "required": [
    "payment_intent_id",
    "restaurant_id",
    "amount",
    "currency",
    "status"
  ]
}