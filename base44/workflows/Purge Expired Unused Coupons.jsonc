{
  "name": "Purge Expired Unused Coupons",
  "description": "Run by hand: moves every coupon that has expired and was never used to Recently deleted (restorable). Coupons with no expiry date or that were used are kept.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "one_time",
      "cron_expression": null,
      "one_time_date": "2027-12-31T05:00:00",
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "purge_expired_coupons",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "purge": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "adminPurgeExpiredCoupons",
            "args": {
              "dry_run": false
            }
          },
          "then": "end"
        }
      }
    ]
  }
}