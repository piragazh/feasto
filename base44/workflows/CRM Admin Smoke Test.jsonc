{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "crm_admin_smoke",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "overview": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "crmAdminApi",
            "args": {
              "action": "overview"
            }
          },
          "then": "contacts"
        }
      },
      {
        "contacts": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "crmAdminApi",
            "args": {
              "action": "contacts_list",
              "search": ""
            }
          },
          "then": "consent"
        }
      },
      {
        "consent": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "crmAdminApi",
            "args": {
              "action": "consent_log"
            }
          },
          "then": "supp"
        }
      },
      {
        "supp": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "crmAdminApi",
            "args": {
              "action": "suppressions_list"
            }
          },
          "then": "costs"
        }
      },
      {
        "costs": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "crmAdminApi",
            "args": {
              "action": "costs"
            }
          },
          "then": "approvals"
        }
      },
      {
        "approvals": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "crmAdminApi",
            "args": {
              "action": "approvals_list"
            }
          },
          "then": "contact"
        }
      },
      {
        "contact": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "crmAdminApi",
            "args": {
              "action": "contact_get",
              "contact_id": "6ad37e8a7a252dd48ca3dd31"
            }
          },
          "then": "automations"
        }
      },
      {
        "automations": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "crmApi",
            "args": {
              "action": "automations_list",
              "restaurant_id": "694fdbd378c562f1444a3302"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "description": "Manual check only: calls each read-only Super Admin CRM action once. Any failure shows in the run. Safe to delete.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "one_time",
      "cron_expression": null,
      "one_time_date": "2027-12-31T04:00:00Z",
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "CRM Admin Smoke Test"
}