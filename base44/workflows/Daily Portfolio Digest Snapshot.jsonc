{
  "name": "Daily Portfolio Digest Snapshot",
  "description": "Generate portfolio-level digest snapshot daily at 09:00 UTC. Hash dedup prevents duplicate snapshots if digest content unchanged.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_portfolio_digest_snapshot",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateScheduledPortfolioSnapshot",
            "args": {
              "authSecret": "SCHEDULED_DIGEST_SECRET"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "generateScheduledPortfolioSnapshot"
  }
}