{
  "name": "CRM Send Worker",
  "description": "Every hour (was every 5 minutes, ~1,700 credits/month for no work): starts scheduled campaigns that are due and sends queued marketing messages held back by quiet hours, re-checking consent, opt-outs, the weekly cap, quiet hours and the monthly SMS budget at the moment of sending. Campaign starts and CRM automations already run the worker directly, so this is the catch-up pass.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "4 * * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "crm_send_worker",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "crmSendWorker",
            "args": {
              "mode": "drain"
            }
          },
          "then": "end"
        }
      }
    ]
  }
}