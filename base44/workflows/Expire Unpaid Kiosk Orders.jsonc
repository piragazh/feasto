{
  "name": "Expire Unpaid Kiosk Orders",
  "description": "Every 5 minutes, cancels kiosk orders still unpaid at the counter after the restaurant's limit (default 15 minutes). They were never cooked and never deducted stock, so nothing needs reversing. Only ever touches orders that are still unpaid and still pending.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": "2026-09-26T00:00:00.000000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "expire_unpaid_kiosk_orders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "expireUnpaidKioskOrders",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}
