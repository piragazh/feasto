{
  "name": "CRM Automations",
  "description": "Every hour: for each restaurant's switched-on automations (welcome, second-order nudge, win-back, lapsed, birthday, VIP thank-you, review request), enrols customers who newly meet the trigger, holds back a control group, and queues their message for the CRM Send Worker. Does nothing when no automation is switched on.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 1,
      "interval_unit": "hours",
      "interval_anchor": "2026-10-21T06:20:00",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "crm_automations",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "crmAutomations",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}