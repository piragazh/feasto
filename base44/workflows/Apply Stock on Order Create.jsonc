{
  "name": "Apply Stock on Order Create",
  "description": "Deducts tracked item stock when an order is created in a committed state, on every order path (till, offline, kiosk, QR, online, marketplaces), and auto-86s items that reach zero. Exactly-once per order via Order.stock_applied.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Order"
    }
  },
  "definition": {
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {
              "p1_dot_entity_id": "${ .entity_id }",
              "p2_workflow_input_entity_id": "${ $workflow.input.entity_id }",
              "p3_input_entity_id": "${ $input.entity_id }",
              "p4_dot_data_id": "${ .data.id }",
              "p5_workflow_input_data_id": "${ $workflow.input.data.id }",
              "p6_dot": "${ . }",
              "p7_workflow_input": "${ $workflow.input }"
            },
            "function_name": "applyOrderStock"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "apply_stock_on_order_create",
      "namespace": "base44",
      "version": "1.2-probe"
    }
  }
}