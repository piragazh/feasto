{
  "name": "Apply Stock on Order Create",
  "description": "Deducts tracked item stock when an order is created in a committed state, on every order path (till, offline, kiosk, QR, online, marketplaces), and auto-86s items that reach zero. Exactly-once per order via Order.stock_applied.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Order"
    }
  },
  "definition": {
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {
              "orderId": "${ .trigger.entity_id }"
            },
            "function_name": "applyOrderStock"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "apply_stock_on_order_create",
      "namespace": "base44",
      "version": "1.4"
    }
  }
}