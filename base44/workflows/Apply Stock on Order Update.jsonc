{
  "name": "Apply Stock on Order Update",
  "description": "Deducts stock when a pending order becomes committed (e.g. online payment confirmed), and restores it when a committed order is cancelled or refunded. Exactly-once in each direction via Order.stock_applied / stock_restored, so this re-firing on its own marker writes is a harmless no-op.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Order"
    }
  },
  "definition": {
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {
              "orderId": "${ .trigger.entity_id }"
            },
            "function_name": "applyOrderStock"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "apply_stock_on_order_update",
      "namespace": "base44",
      "version": "1.1"
    }
  }
}