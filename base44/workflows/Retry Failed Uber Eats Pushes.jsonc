{
  "name": "Retry Failed Uber Eats Pushes",
  "description": "Every 2 minutes, retries Uber Eats accept / deny / ready / cancel calls that failed and whose back-off has elapsed (Order.uber_push_pending). Uber auto-cancels an order that is not accepted or denied within 11.5 minutes, so a failed accept cannot wait for the next order change. Normally finds nothing to do.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 2,
      "interval_unit": "minutes",
      "interval_anchor": "2026-10-03T09:00:00.000000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "retry_failed_uber_eats_pushes",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "uberEatsPushStatus",
            "args": {
              "sweep": true
            }
          },
          "then": "end"
        }
      }
    ]
  }
}