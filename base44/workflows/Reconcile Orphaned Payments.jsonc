{
  "name": "Reconcile Orphaned Payments",
  "description": "Daily safety net (was every 15 minutes, ~580 credits/month): finds PaymentTransaction records stuck in 'authorized' or 'order_failed' (order never created after charge) and refunds them via Stripe; escalates 'refund_failed' to manual_review. No current code path writes those statuses - the Stripe webhook now creates the order or refunds directly - so this only catches leftovers.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "13 4 * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "reconcile_orphaned_payments",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "reconcileOrphanedPayments",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "reconcileOrphanedPayments"
  }
}