{
  "_comment": "Merge the 'scripts' block below into your package.json. These scripts are required by the CI workflow and local quality gate.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",

    "lint": "eslint src --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",

    "typecheck": "tsc --noEmit 2>/dev/null || echo '[typecheck] No tsconfig found — skipping'",

    "test": "vitest --config vitest.config.js",
    "test:run": "vitest run --config vitest.config.js",
    "test:watch": "vitest watch --config vitest.config.js",
    "test:coverage": "vitest run --config vitest.config.js --coverage",

    "check:mirror-sync": "node scripts/check-mirror-sync.js",

    "verify": "npm run lint && npm run typecheck && npm run test:run && npm run check:mirror-sync && npm run build",
    "ci": "npm run verify",

    "smoke": "node scripts/smoke/run-smoke.js",
    "smoke:manifest": "node scripts/smoke/run-smoke.js --only getManifest",
    "smoke:order": "node scripts/smoke/run-smoke.js --only verifyAndCreateOrder",
    "smoke:coupon": "node scripts/smoke/run-smoke.js --only validateCouponUsage",
    "smoke:audit": "node scripts/smoke/run-smoke.js --only auditLog",
    "smoke:payment": "node scripts/smoke/run-smoke.js --only createPaymentIntent",
    "smoke:permissions": "node scripts/smoke/run-smoke.js --only enforceRestaurantPermissions",
    "smoke:cleanup": "node scripts/smoke/cleanup-smoke-orders.js",
    "smoke:moneycontrols": "node scripts/smoke/run-smoke.js --only posApplyDiscount,posVoidOrder,approveRefund,platformRefundOverride,auditSensitiveAction"
  }
}